      original_chunk {
        target_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nexport default function App() {\n  return <div></div>;\n}\n"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport \'./index.css\';\n\nconst CA = \'0x196A3Ab28E1e854a040e57576cf94ff99d7F3Acc\';\nconst RPC = \'https://rpc.mainnet.chain.robinhood.com\';\nconst INITIAL_SUPPLY = 1e9; // 1B tokens at launch\nconst LETSCASH_API = \'https://api.letscash.fun/api/tokens/\' + CA + \'?surface=current\';\nconst DEXSCREENER_API = \'https://api.dexscreener.com/latest/dex/tokens/\' + CA;\nconst CASHCAT_BUYBACK_SHARE = 0.003;\n\nfunction fmt(n: number, dec = 2) {\n  if (n >= 1e9) return (n / 1e9).toFixed(dec) + \'B\';\n  if (n >= 1e6) return (n / 1e6).toFixed(dec) + \'M\';\n  if (n >= 1e3) return (n / 1e3).toFixed(dec) + \'K\';\n  return n.toFixed(dec);\n}\n\nfunction AnimatedNumber({ value }: { value: number }) {\n  const [displayed, setDisplayed] = useState(0);\n\n  useEffect(() => {\n    let start = displayed;\n    let t0 = performance.now();\n    let dur = 1200;\n    let req: number;\n\n    function step(t: number) {\n      const p = Math.min((t - t0) / dur, 1);\n      const eased = 1 - Math.pow(1 - p, 3);\n      const val = start + (value - start) * eased;\n      setDisplayed(val);\n      if (p < 1) req = requestAnimationFrame(step);\n      else setDisplayed(value);\n    }\n    req = requestAnimationFrame(step);\n    return () => cancelAnimationFrame(req);\n  }, [value]);\n\n  return <>{fmt(displayed, 2)}</>;\n}\n\nexport default function App() {\n  const [copied, setCopied] = useState(false);\n  const [stats, setStats] = useState({\n    burned: 0,\n    pct: 0,\n    supply: 0,\n    cashcatEth: null as number | null,\n    burnedUsd: null as number | null,\n  });\n\n  const copyCA = () => {\n    navigator.clipboard.writeText(CA).then(() => {\n      setCopied(true);\n      setTimeout(() => setCopied(false), 1600);\n    });\n  };\n\n  useEffect(() => {\n    async function fetchSupplyRPC() {\n      const res = await fetch(RPC, {\n        method: \'POST\',\n        headers: { \'content-type\': \'application/json\' },\n        body: JSON.stringify({\n          jsonrpc: \'2.0\',\n          id: 1,\n          method: \'eth_call\',\n          params: [{ to: CA, data: \'0x18160ddd\' }, \'latest\']\n        })\n      });\n      const j = await res.json();\n      if (!j.result || j.result === \'0x\') throw new Error(\'no result\');\n      return Number(BigInt(j.result)) / 1e18;\n    }\n\n    async function updateBurn() {\n      let supply: number | null = null;\n      let cashcatEth: number | null = null;\n      try {\n        const lcRes = await fetch(LETSCASH_API);\n        const lc = await lcRes.json();\n        supply = lc.circulatingSupply;\n        if (lc.volumeEth && lc.volumeEth.allTime) {\n          cashcatEth = lc.volumeEth.allTime * CASHCAT_BUYBACK_SHARE;\n        }\n      } catch (e) {\n        // fall back to RPC\n      }\n\n      try {\n        if (!supply) supply = await fetchSupplyRPC();\n      } catch (e) {\n        return;\n      }\n\n      const burned = INITIAL_SUPPLY - supply;\n      const pct = (burned / INITIAL_SUPPLY) * 100;\n      let burnedUsd: number | null = null;\n\n      try {\n        const dsRes = await fetch(DEXSCREENER_API);\n        const ds = await dsRes.json();\n        const price = parseFloat(ds.pairs?.[0]?.priceUsd);\n        if (price > 0) {\n          burnedUsd = burned * price;\n        }\n      } catch (e) {\n        // leave placeholder\n      }\n\n      setStats({ burned, pct, supply, cashcatEth, burnedUsd });\n    }\n\n    updateBurn();\n    const interval = setInterval(updateBurn, 12000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <div className=\"wrap\">\n      <header>\n        <div className=\"brand\">\n          <img src=\"https://dd.dexscreener.com/ds-data/tokens/robinhood/0x196a3ab28e1e854a040e57576cf94ff99d7f3acc.png?size=lg\" alt=\"Serious Cat logo\" />\n          Serious Cat\n        </div>\n        <nav>\n          <a href=\"#burn\">the incinerator \360\237\224\245</a>\n          <a href=\"#community\">the council</a>\n          <a href=\"https://www.letscash.fun/token/0x196a3ab28e1e854a040e57576cf94ff99d7f3acc\" target=\"_blank\" rel=\"noopener noreferrer\">buy</a>\n        </nav>\n      </header>\n\n      <section className=\"hero\" style={{ borderTop: \'none\' }}>\n        <div className=\"pfp-stack\">\n          <img className=\"pfp\" src=\"https://cdn.dexscreener.com/cms/images/x-coFChfby2uFeW_?width=800&height=800&quality=90&format=webp\" alt=\"Serious Cat\" />\n          <div className=\"no-fun\">not amused.</div>\n        </div>\n        <h1 className=\"display\">this cat is <span className=\"serious\">SERIOUS</span></h1>\n        <div className=\"ticker\">$SERIOUSCAT</div>\n        <p className=\"tagline\">The Original Picture of Cash Cat is Serious Cat.</p>\n        <p className=\"tagline-sub\">before the memes. before the money. there was <span className=\"hl\">the stare</span>.</p>\n        <p className=\"chain-badge\">deployed with a straight face on <b>Robinhood Chain</b> \302\267 trades vs ETH \302\267 contract verified (he checked. twice.)</p>\n\n        <div className=\"cta\">\n          <a className=\"btn btn-primary\" href=\"https://www.letscash.fun/token/0x196a3ab28e1e854a040e57576cf94ff99d7f3acc\" target=\"_blank\" rel=\"noopener noreferrer\">\360\237\230\276 buy the cat</a>\n          <a className=\"btn btn-ghost\" href=\"https://dexscreener.com/robinhood/0x196a3ab28e1e854a040e57576cf94ff99d7f3acc\" target=\"_blank\" rel=\"noopener noreferrer\">\360\237\223\210 stare at the chart</a>\n        </div>\n\n        <div className=\"ca-box\">\n          <span className=\"label\">CA</span>\n          <code id=\"ca\">{CA}</code>\n          <button className={`copy-btn ${copied ? \'copied\' : \'\'}`} onClick={copyCA}>\n            {copied ? \'copied \360\237\230\276\' : \'copy it\'}\n          </button>\n        </div>\n        <p className=\"ca-note\">yes, that\'s the real one. the cat does not do fakes.</p>\n      </section>\n\n      <section id=\"burn\">\n        <h2 className=\"display\">\360\237\224\245 the incinerator</h2>\n        <p className=\"section-sub\">\n          the cat does not pay himself. <b>nobody collects creator fees. ever.</b><br />\n          instead, <span className=\"hl\">0.7% of every single trade</span> automatically buys $SERIOUSCAT\n          and yeets it straight into the void. gone. deleted. unfollowed from existence.<br />\n          <span className=\"small\">the burner is the registered fee recipient and cannot be changed. this is not a promise \342\200\224 it\'s the contract.</span>\n        </p>\n\n        <div className=\"burn-hero\">\n          <div className=\"flame\">\360\237\224\245</div>\n          <div className=\"burn-amount display\">\n            {stats.burned > 0 ? <AnimatedNumber value={stats.burned} /> : \'\342\200\224\'}\n          </div>\n          <div className=\"burn-unit\">$SERIOUSCAT sent to the shadow realm</div>\n          <div className=\"burn-unit-sub\">and they are never coming back</div>\n\n          <div className=\"burn-bar\">\n            <div className=\"fill\" style={{ width: `${Math.max(stats.pct, 1.5)}%` }}></div>\n          </div>\n          <div className=\"burn-bar-label\">progress toward absolute seriousness</div>\n\n          <div className=\"burn-stats\">\n            <div className=\"stat\">\n              <div className=\"v\">{stats.burnedUsd ? `$${fmt(stats.burnedUsd, 1)}` : \'\342\200\224\'}</div>\n              <div className=\"k\">street value of the ashes (at current price)</div>\n            </div>\n            <div className=\"stat\">\n              <div className=\"v\">{stats.pct > 0 ? `${stats.pct.toFixed(2)}%` : \'\342\200\224\'}</div>\n              <div className=\"k\">of supply gone. poof.</div>\n            </div>\n            <div className=\"stat\">\n              <div className=\"v\">{stats.supply > 0 ? fmt(stats.supply, 2) : \'\342\200\224\'}</div>\n              <div className=\"k\">supply right now (shrinking)</div>\n            </div>\n            <div className=\"stat\">\n              <div className=\"v\">1.00B</div>\n              <div className=\"k\">supply at launch (rip)</div>\n            </div>\n          </div>\n\n          <div className=\"cashcat-strip\">\n            \360\237\220\210\342\254\233 and the other 0.3%? it buys back <b>$CASHCAT</b> \342\200\224 <b>{stats.cashcatEth ? `~${stats.cashcatEth.toFixed(2)}` : \'\342\200\224\'}</b> ETH fed to the elder cat so far. respect the lineage.\n          </div>\n\n          <div className=\"live-note\"><span className=\"live-dot\"></span>live data from Robinhood Chain, letscash.fun &amp; dexscreener \342\200\224 the cat refuses to fake stats</div>\n        </div>\n\n        <div className=\"how-burn\">\n          <div className=\"how-card\">\n            <div className=\"emoji\">\360\237\222\270</div>\n            <h3>1% tax. that\'s it.</h3>\n            <p>every buy and sell pays 1% in ETH. 0.7% feeds the fire, 0.3% buys back $CASHCAT. even the fees are cats.</p>\n          </div>\n          <div className=\"how-card\">\n            <div className=\"emoji\">\360\237\244\226</div>\n            <h3>the burn is automatic</h3>\n            <p>a machine buys the cat\'s own token and destroys it. no human hands. no \"trust me bro\". anyone can trigger it.</p>\n          </div>\n          <div className=\"how-card\">\n            <div className=\"emoji\">\360\237\223\211</div>\n            <h3>supply only goes down</h3>\n            <p>number of tokens: shrinking. seriousness of cat: constant. this is the way.</p>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"community\">\n        <h2 className=\"display\">the council of serious business</h2>\n        <p className=\"section-sub\">no jokes allowed. okay maybe some jokes. the cat will decide.</p>\n        <div className=\"social-grid\">\n          <a className=\"social-card\" href=\"https://x.com/SeriousCatRH\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <div className=\"icon\">\360\235\225\217</div>\n            <div><div className=\"t\">X / Twitter</div><div className=\"d\">@SeriousCatRH \342\200\224 serious posts only</div></div>\n          </a>\n          <a className=\"social-card\" href=\"https://t.me/seriouscatrh\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <div className=\"icon\">\342\234\210\357\270\217</div>\n            <div><div className=\"t\">Telegram</div><div className=\"d\">t.me/seriouscatrh \342\200\224 the war room</div></div>\n          </a>\n          <a className=\"social-card\" href=\"https://dexscreener.com/robinhood/0x196a3ab28e1e854a040e57576cf94ff99d7f3acc\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <div className=\"icon\">\360\237\223\212</div>\n            <div><div className=\"t\">DexScreener</div><div className=\"d\">candles. green ones, preferably.</div></div>\n          </a>\n          <a className=\"social-card\" href=\"https://knowyourmeme.com/memes/serious-cat\" target=\"_blank\" rel=\"noopener noreferrer\">\n            <div className=\"icon\">\360\237\230\276</div>\n            <div><div className=\"t\">Know Your Meme</div><div className=\"d\">the lore. est. 2003. respect your elders.</div></div>\n          </a>\n        </div>\n      </section>\n\n      <footer>\n        <div className=\"stamp\">Serious Cat ($SERIOUSCAT) \302\267 Robinhood Chain \302\267 est. with a straight face</div>\n        <p className=\"disclaimer\">\n          this is a community meme token. the cat is serious \342\200\224 you should still be sensible.\n          nothing here is financial advice. crypto is volatile: never invest more than you can afford to lose.\n        </p>\n      </footer>\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
